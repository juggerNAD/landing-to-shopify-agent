# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-5-5

# Shopify dev store (no https://)
SHOPIFY_STORE=your-dev-store.myshopify.com
SHOPIFY_API_VERSION=2026-07

# Auth option A: Admin API access token (custom app installed in the store)
SHOPIFY_ADMIN_TOKEN=shpat_...
# Auth option B: Dev Dashboard app (client credentials grant) - used if no token above
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Storefront password (dev stores are always password protected)
SHOPIFY_STOREFRONT_PASSWORD=

# Optional: target a specific theme ID (numeric). Defaults to the live (MAIN) theme.
SHOPIFY_THEME_ID=
